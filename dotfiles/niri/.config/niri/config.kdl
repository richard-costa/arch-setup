// Portable Niri configuration.
//
// Most settings are split into cfg/*.kdl so each concern is easy to find.
// display.kdl is intentionally host-specific and is linked by install/host.sh.
//
// noctalia.kdl is generated by Noctalia from the active wallpaper palette.
// install/dotfiles.sh creates an empty placeholder so Niri can start before
// Noctalia renders the real file.

include "./cfg/animation.kdl"
include "./cfg/autostart.kdl"
include "./cfg/keybinds.kdl"
include "./cfg/input.kdl"
include "./cfg/display.kdl"
include "./cfg/layout.kdl"
include "./cfg/rules.kdl"
include "./cfg/misc.kdl"

include "noctalia.kdl"
