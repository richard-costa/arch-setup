// Monitor layout for this Acer laptop.
//
// Connector names and positions are machine-specific, so this file lives under
// hosts/ rather than the portable Niri dotfiles.
//
// Current layout:
//   [ laptop 1366x768 ][ LG ultrawide 2560x1080 ]

output "eDP-1" {
    mode "1366x768@60.004"
    scale 1
    transform "normal"
    position x=0 y=0
}

output "HDMI-A-1" {
    mode "2560x1080@59.978"
    scale 1
    transform "normal"
    position x=1366 y=0
}
